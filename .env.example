# SplashLens app / PoolLens source repo
# Cloudflare Pages project: poolens

# Required in production. Set as a Cloudflare Pages secret.
ANTHROPIC_API_KEY=

# Recommended production marker. The scan function also treats app.splashlens.com
# and *.pages.dev as production hosts.
ENVIRONMENT=production

# Optional local-only development marker.
NODE_ENV=development

# Cloudflare bindings to configure in the Pages project, not plain env vars:
# - SCAN_USAGE_KV: KV namespace for monthly server-side scan metering.
# - SCAN_RATE_LIMITER: Cloudflare Rate Limiting binding for burst protection.
#
# Stripe/checkout configuration for paid scanner activation:
# - STRIPE_SECRET_KEY is a Cloudflare Pages secret. Required only when
#   SPLASHLENS_CHECKOUT_MODE=stripe_checkout for first-party Checkout Sessions.
# - STRIPE_WEBHOOK_SECRET is required for /api/stripe-webhook Payment Link
#   fulfillment and automatic entitlement emails.
# - Price IDs can be overridden if the Stripe catalog changes.
# Optional override. By default, /api/checkout attempts Stripe Checkout first
# and falls back to live Payment Links if Stripe is not configured.
SPLASHLENS_CHECKOUT_MODE=stripe_checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SPLASHLENS_STRIPE_PRICE_MONTHLY=price_1TbAp725fqLun6cVz5lhOiiS
SPLASHLENS_STRIPE_PRICE_YEARLY=price_1TbAp825fqLun6cVoVG0wqQl
SPLASHLENS_STRIPE_PAYMENT_LINK_MONTHLY_ID=
SPLASHLENS_STRIPE_PAYMENT_LINK_YEARLY_ID=
# Temporary fallback only if the Stripe endpoint is dedicated to SplashLens.
SPLASHLENS_STRIPE_WEBHOOK_ALLOW_UNTAGGED_PAYMENT_LINKS=false
SPLASHLENS_APP_ORIGIN=https://app.splashlens.com

# Native app subscriptions. These are required before StoreKit / Play Billing
# can issue paid scanner entitlements from /api/native-entitlement.
SPLASHLENS_ENTITLEMENT_SECRET=
SPLASHLENS_NATIVE_BILLING_SHARED_SECRET=
SPLASHLENS_IOS_BUNDLE_ID=com.splashlens.app
APPLE_APP_STORE_CONNECT_ISSUER_ID=
APPLE_APP_STORE_CONNECT_KEY_ID=
APPLE_APP_STORE_CONNECT_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=com.splashlens.fieldtools
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional affiliate redirect URL templates. Leave blank until partner accounts
# are approved. Use {q} as the URL-encoded search query placeholder.
SPLASHLENS_AFFILIATE_LESLIES_URL_TEMPLATE=
SPLASHLENS_AFFILIATE_INTHESWIM_URL_TEMPLATE=
SPLASHLENS_AFFILIATE_POOLSUPPLYWORLD_URL_TEMPLATE=
